# Server configuration. Copy to `.env` and edit; `.env` itself is never committed.
# Every setting has a working default, so an empty file is a valid one.

# Where the API listens. The Vite dev server proxies /api here.
PORT=8787

# The address it listens on. Loopback: the API has no accounts and deletes books on request, so it
# answers this machine only. 0.0.0.0 opens it to everyone on your network.
HOST=127.0.0.1

# The SQLite file the library is stored in. Created on first run.
DATABASE_URL=./data/library.db

# Hard ceiling on an uploaded EPUB, in megabytes.
MAX_UPLOAD_MB=64

# Hard ceilings on what an upload unzips to, in megabytes: everything in it together, and any one
# document in it (a chapter file, above all). A zip can be a thousand times smaller than its
# contents, so the upload limit alone does not bound what an import holds in memory.
MAX_UNZIPPED_MB=512
MAX_DOCUMENT_MB=32

# How much is logged: trace, debug, info, warn, error, fatal, silent.
LOG_LEVEL=info

# `pretty` for a person at a terminal, `json` for anything a machine reads. Left unset it decides
# from whether stdout is a terminal, which is right unless you are piping a dev server somewhere.
# LOG_FORMAT=pretty
#
# Colour follows the usual conventions: NO_COLOR turns it off, FORCE_COLOR turns it on for a CI
# that renders ANSI without being a terminal.

# Frontend mode: `demo` (default) runs the seeded world with no backend at all;
# `backend` talks to the server above. Neither ever silently becomes the other.
VITE_MODE=demo

# Whether scripting calls a real model. `fake` reads the prose and never the network, so nothing
# this server does can spend money. `endpoints` sends each chapter to the scripting profile its run
# was queued with, at the base URL, model and key saved for it on the Endpoints page. No provider is
# configured in this file: that is the page's, and the key is kept by the server, not the browser.
SCRIPTING_PROVIDER=fake

# Whether narration calls a real model. `fake` renders a quiet tone and never the network.
# `endpoints` sends each line to the endpoint its speaker's voice belongs to: Fish Audio when the
# base URL is Fish's, OpenAI's /audio/speech shape (OpenAI, Kokoro-FastAPI, …) otherwise.
SPEECH_PROVIDER=fake

# Where rendered clips are written: a directory per book, a file per render. A clip's url points
# here, so move the files if you move this.
AUDIO_DIR=./data/audio

# Which encoder a build writes an audiobook with.
#
# `wav` is the default and needs nothing installed: it stitches the rendered clips into one real,
# playable file per output file and never reaches the network, so a build costs nothing and still
# writes something you can listen to. It is not an M4B and writes no chapter marks, and a build
# says so in its log rather than naming the file as though it were one.
#
# `ffmpeg` writes the format the settings actually asked for — AAC in an M4B with the chapter
# marks a player reads, or an MP3 — and measures and corrects loudness when the build asks for it.
# It runs the ffmpeg already on this machine, so the server refuses to start when there is none.
EXPORT_ENCODER=wav

# The ffmpeg to run, for a machine that keeps it somewhere off PATH. Only read by `EXPORT_ENCODER=ffmpeg`.
FFMPEG_BIN=ffmpeg

# Where built audiobooks are kept: a directory per book, a file per output file. Deliberately not
# beside the clips — a clip is an input the next build reads again, an audiobook is the deliverable.
EXPORT_DIR=./data/exports

# Only `pnpm test:live` reads these: a real request each, to prove the providers against the real
# APIs. The server never does — a running server takes its providers from the Endpoints page.
# SCRIPTING_PROVIDER_URL=http://localhost:9092/v1
# SCRIPTING_PROVIDER_MODEL=
# SCRIPTING_PROVIDER_TOKEN=
# FISHAUDIO_TOKEN=
# FISHAUDIO_VOICE_ID=
